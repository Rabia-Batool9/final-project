ly compare deep learning classification vs classical ML classification on the same learned features."]},{"cell_type":"code","execution_count":15,"id":"8ac1e431","metadata":{"execution":{"iopub.execute_input":"2026-08-28T06:33:56.742955Z","iopub.status.busy":"2026-08-28T06:33:56.742498Z","iopub.status.idle":"2026-08-28T06:34:22.129829Z","shell.execute_reply":"2026-08-28T06:34:22.128914Z"},"papermill":{"duration":25.475132,"end_time":"2026-08-28T06:34:22.131559+00:00","exception":false,"start_time":"2026-08-28T06:33:56.656427+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Extracting training features...\n","\u001b[1m90/90\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m19s\u001b[0m 171ms/step\n","Extracting test features...\n","\u001b[1m13/13\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m5s\u001b[0m 417ms/step\n","Feature shapes: (2870, 2048) (394, 2048)\n"]}],"source":["# Build a feature-extractor model that outputs the GlobalAveragePooling layer\n","feature_extractor = Model(inputs=transfer_model.input,\n","                           outputs=transfer_model.get_layer('feature_vector').output)\n","\n","def extract_features(generator):\n","    generator.reset()\n","    features = feature_extractor.predict(generator, verbose=1)\n","    labels = generator.classes[:len(features)]\n","    return features, labels\n","\n","print('Extracting training features...')\n","X_train_feat, y_train_feat = extract_features(transfer_feat_train_gen)\n","\n","print('Extracting test features...')\n","X_test_feat, y_test_feat = extract_features(transfer_test_gen)\n","\n","print('Feature shapes:', X_train_feat.shape, X_test_feat.shape)\n","\n"]},{"cell_type":"code","execution_count":16,"id":"6cfa0b5a","metadata":{"execution":{"iopub.execute_input":"2026-08-28T06:34:22.320198Z","iopub.status.busy":"2026-08-28T06:34:22.319734Z","iopub.status.idle":"2026-08-28T06:35:01.496886Z","shel