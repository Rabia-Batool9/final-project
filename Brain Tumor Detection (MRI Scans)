 \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m5s\u001b[0m 438ms/step\n","Feature shapes: (2870, 2048) (394, 2048)\n"]}],"source":["# Build a feature-extractor model that outputs the GlobalAveragePooling layer\n","feature_extractor = Model(inputs=transfer_model.input,\n","                           outputs=transfer_model.get_layer('feature_vector').output)\n","\n","def extract_features(generator):\n","    generator.reset()\n","    features = feature_extractor.predict(generator, verbose=1)\n","    labels = generator.classes[:len(features)]\n","    return features, labels\n","\n","print('Extracting training features...')\n","X_train_feat, y_train_feat = extract_features(transfer_feat_train_gen)\n","\n","print('Extracting test features...')\n","X_test_feat, y_test_feat = extract_features(transfer_test_gen)\n","\n","print('Feature shapes:', X_train_feat.shape, X_test_feat.shape)\n","\n"]},{"cell_type":"code","execution_count":16,"id":"37b59cae","metadata":{"execution":{"iopub.execute_input":"2026-08-28T05:39:50.32515Z","iopub.status.busy":"2026-08-28T05:39:50.324775Z","iopub.status.idle":"2026-08-28T05:40:29.986053Z","shell.execute_reply":"2026-08-28T05:40:29.985486Z"},"papermill":{"duration":39.735138,"end_time":"2026-08-28T05:40:29.988228+00:00","exception":false,"start_time":"2026-08-28T05:39:50.25309+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Training SVM...\n","SVM done.\n","Training Random Forest...\n","Random Forest done.\n","Training Logistic Regression...\n","Logistic Regression done.\n"]}],"source":["classical_models = {\n","    'SVM': SVC(kernel='rbf', probability=True, random_state=42),\n","    'Random Forest': RandomForestClassifier(n_estimators=200, random_state=42),\n","    'Logistic Regression': LogisticRegression(max_iter=1000, random_state=42),\n","}\n","\n","classical_predictions = {}\n","for name, clf in classical_models.items():\n","    print(f'Training {name}...')\n","  