788 - val_loss: 0.4046\n","Found 2870 images belonging to 4 classes.\n"]}],"source":["history_transfer = transfer_model.fit(transfer_train_gen, validation_data=transfer_val_gen,\n","                                       epochs=EPOCHS, callbacks=[early_stop])\n","transfer_model.save(f'{WORK_DIR}/transfer_model.keras')\n","# non-shuffled version for feature extraction (uses same ResNet50 preprocessing)\n","transfer_feat_train_gen = transfer_test_datagen.flow_from_directory(\n","    TRAIN_DIR, target_size=IMAGE_SIZE, batch_size=BATCH_SIZE,\n","    class_mode='categorical', classes=CLASS_NAMES, shuffle=False)"]},{"cell_type":"markdown","id":"f50258da","metadata":{"papermill":{"duration":0.103069,"end_time":"2026-08-28T06:06:08.189804+00:00","exception":false,"start_time":"2026-08-28T06:06:08.086735+00:00","status":"completed"},"tags":[]},"source":["## 9. Model 4 — Classical Supervised ML on CNN-Extracted Features\n","This is the explicit **Supervised ML module** component: instead of letting the neural network classify directly, we use the fine-tuned transfer model as a **feature extractor** (its `feature_vector` layer output), then train classical supervised ML algorithms — **SVM, Random Forest, Logistic Regression** — on those features. This lets you directly compare deep learning classification vs classical ML classification on the same learned features."]},{"cell_type":"code","execution_count":15,"id":"a38de672","metadata":{"execution":{"iopub.execute_input":"2026-08-28T06:06:08.393668Z","iopub.status.busy":"2026-08-28T06:06:08.393152Z","iopub.status.idle":"2026-08-28T06:06:32.717713Z","shell.execute_reply":"2026-08-28T06:06:32.716704Z"},"papermill":{"duration":24.428363,"end_time":"2026-08-28T06:06:32.719222+00:00","exception":false,"start_time":"2026-08-28T06:06:08.290859+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Extracting training features...\n","\u001b[1m90/90\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m18s\u001b[0m 160ms/step\n","Extracting test features...\n","\u001b[1m13/13\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m5s\u001b[0m 425ms/step\n","Feature shapes: (2870, 2048) (394, 2048)\n"]}],"source":["# Build a feature-extractor model that outputs the GlobalAveragePooling layer\n","feature_extractor = Model(inputs=transfer_model.input,\n","                           outputs=transfer_model.get_layer('feature_vector').output)\n","\n","def extract_features(generator):\n","    generator.reset()\n","    features = feature_extractor.predict(generator, verbose=1)\n","    labels = generator.classes[:len(features)]\n","    return features, labels\n","\n","print('Extracting training features...')\n","X_train_feat, y_train_feat = extract_features(transfer_feat_train_gen)\n","\n","print('Extracting test features...')\n","X_test_feat, y_test_feat = extract_features(transfer_test_gen)\n","\n","print('Feature shapes:', X_train_feat.shape, X_test_feat.shape)\n","\n"]},{"cell_type":"code","execution_count":16,"id":"3a875746","metadata":{"execution":{"iopub.execute_input":"2026-08-28T06:06:32.931464Z","iopub.status.busy":"2026-08-28T06:06:32.9312Z","iopub.status.idle":"2026-08-28T06:07:14.350774Z","shell.execute_reply":"2026-08-28T06:07:14.349554Z"},"papermill":{"duration":41.531301,"end_time":"2026-08-28T06:07:14.355638+00:00","exception":false,"start_time":"2026-08-28T06:06:32.824337+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Training SVM...\n","SVM done.\n","Training Random Forest...\n","Random Forest done.\n","Training Logistic Regression...\n","Logistic Regression done.\n"]}],"source":["classical_models = {\n","    'SVM': SVC(kernel='rbf', probability=True, random_state=42),\n","    'Random Forest': RandomForestClassifier(n_estimators=200, random_state=42),\n","    'Logistic Regression': LogisticRegression(max_iter=1000, random_state=42),\n","}\n","\n","